{% doc %}
  @prompt
    Create a reusable animated button component with the following specs:
    
    - Width: 220px, Height: 50px
    - Text: uppercase, clean modern font
    - Include a right arrow icon that moves slightly right on hover
    
    Default State:
    - Background: #000000, Text: #ffffff, Border: 1px solid #000000
    
    Hover Animation:
    - A yellow (#FFF544) background slides from LEFT to RIGHT using a pseudo-element (::before or ::after) with transform: translateX() or scaleX() and smooth CSS transitions
    - After animation: background fully #FFF544, text becomes #000000
    - On mouse leave: yellow slides back from RIGHT to LEFT, returns to black background and white text
    
    Technical:
    - Use pseudo-elements for sliding background effect
    - CSS transitions with ease or cubic-bezier timing
    - Arrow icon translateX on hover
    - Clean reusable CSS class (.animated-button)
    - No external libraries, pure HTML + CSS + vanilla JavaScript
    - Production-ready and well-structured
    - Include two button examples: one with "SHOP NOW" and one with "CHOOSE GIFT"
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-animated-button-container-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-animated-button-wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }

  .ai-animated-button-{{ ai_gen_id }} {
    position: relative;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: {{ block.settings.button_width }}px;
    height: {{ block.settings.button_height }}px;
    background-color: {{ block.settings.default_bg_color }};
    color: {{ block.settings.default_text_color }};
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.default_border_color }};
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    overflow: hidden;
    z-index: 1;
    transition: color 0.4s {{ block.settings.timing_function }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
  }

  .ai-animated-button-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.hover_bg_color }};
    transform: translateX(-100%);
    transition: transform 0.4s {{ block.settings.timing_function }};
    z-index: -1;
  }

  .ai-animated-button-{{ ai_gen_id }}:hover::before {
    transform: translateX(0);
  }

  .ai-animated-button-{{ ai_gen_id }}:hover {
    color: {{ block.settings.hover_text_color }};
    border-color: {{ block.settings.hover_border_color }};
  }

  .ai-animated-button-text-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ai-animated-button-arrow-{{ ai_gen_id }} {
    display: inline-flex;
    transition: transform 0.3s {{ block.settings.timing_function }};
  }

  .ai-animated-button-{{ ai_gen_id }}:hover .ai-animated-button-arrow-{{ ai_gen_id }} {
    transform: translateX({{ block.settings.arrow_move_distance }}px);
  }

  .ai-animated-button-arrow-{{ ai_gen_id }} svg {
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    fill: currentColor;
  }

  @media screen and (max-width: 749px) {
    .ai-animated-button-{{ ai_gen_id }} {
      width: 100%;
      max-width: {{ block.settings.button_width }}px;
    }
  }
{% endstyle %}

<animated-button-{{ ai_gen_id }}
  class="ai-animated-button-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-animated-button-wrapper-{{ ai_gen_id }}">
    <a
      href="{{ block.settings.button_1_link }}"
      class="ai-animated-button-{{ ai_gen_id }}"
    >
      <span class="ai-animated-button-text-{{ ai_gen_id }}">
        {{ block.settings.button_1_text }}
        <span class="ai-animated-button-arrow-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M13.025 1l-2.847 2.828 6.176 6.176h-16.354v3.992h16.354l-6.176 6.176 2.847 2.828 10.975-11z"/>
          </svg>
        </span>
      </span>
    </a>

    <a
      href="{{ block.settings.button_2_link }}"
      class="ai-animated-button-{{ ai_gen_id }}"
    >
      <span class="ai-animated-button-text-{{ ai_gen_id }}">
        {{ block.settings.button_2_text }}
        <span class="ai-animated-button-arrow-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M13.025 1l-2.847 2.828 6.176 6.176h-16.354v3.992h16.354l-6.176 6.176 2.847 2.828 10.975-11z"/>
          </svg>
        </span>
      </span>
    </a>
  </div>
</animated-button-{{ ai_gen_id }}>

<script>
  (function() {
    class AnimatedButton{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.buttons = this.querySelectorAll('.ai-animated-button-{{ ai_gen_id }}');
      }
    }

    customElements.define('animated-button-{{ ai_gen_id }}', AnimatedButton{{ ai_gen_id }});
  })();
</script>

