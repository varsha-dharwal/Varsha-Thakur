{% doc %}
  @prompt
    creta a header with the 3 section on the left right and middle
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-header-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    border-bottom: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
  }

  .ai-header-container-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    gap: 20px;
  }

  .ai-header-section-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
  }

  .ai-header-left-{{ ai_gen_id }} {
    justify-content: flex-start;
    flex: 1;
  }

  .ai-header-middle-{{ ai_gen_id }} {
    justify-content: center;
    flex: 1;
  }

  .ai-header-right-{{ ai_gen_id }} {
    justify-content: flex-end;
    flex: 1;
  }

  .ai-header-logo-{{ ai_gen_id }} {
    max-width: {{ block.settings.logo_width }}px;
    height: auto;
  }

  .ai-header-logo-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.logo_width }}px;
    height: 50px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .ai-header-logo-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: {{ block.settings.logo_width }}px;
    max-height: 50px;
  }

  .ai-header-nav-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.nav_spacing }}px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ai-header-nav-{{ ai_gen_id }} a {
    color: {{ block.settings.text_color }};
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .ai-header-nav-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-header-container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 15px;
    }

    .ai-header-section-{{ ai_gen_id }} {
      width: 100%;
      justify-content: center;
    }

    .ai-header-left-{{ ai_gen_id }},
    .ai-header-right-{{ ai_gen_id }} {
      justify-content: center;
    }

    .ai-header-nav-{{ ai_gen_id }} {
      flex-wrap: wrap;
      justify-content: center;
    }
  }
{% endstyle %}

<header-block-{{ ai_gen_id }} class="ai-header-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-header-container-{{ ai_gen_id }}">
    <div class="ai-header-section-{{ ai_gen_id }} ai-header-left-{{ ai_gen_id }}">
      {% if block.settings.left_content_type == 'text' %}
        {{ block.settings.left_text }}
      {% elsif block.settings.left_content_type == 'navigation' %}
        <nav>
          <ul class="ai-header-nav-{{ ai_gen_id }}">
            {% if block.settings.left_link_1_text != blank %}
              <li>
                <a href="{{ block.settings.left_link_1_url }}">{{ block.settings.left_link_1_text }}</a>
              </li>
            {% endif %}
            {% if block.settings.left_link_2_text != blank %}
              <li>
                <a href="{{ block.settings.left_link_2_url }}">{{ block.settings.left_link_2_text }}</a>
              </li>
            {% endif %}
            {% if block.settings.left_link_3_text != blank %}
              <li>
                <a href="{{ block.settings.left_link_3_url }}">{{ block.settings.left_link_3_text }}</a>
              </li>
            {% endif %}
          </ul>
        </nav>
      {% endif %}
    </div>

    <div class="ai-header-section-{{ ai_gen_id }} ai-header-middle-{{ ai_gen_id }}">
      {% if block.settings.middle_content_type == 'logo' %}
        {% if block.settings.logo %}
          <a href="/">
            <img
              src="{{ block.settings.logo | image_url: width: 400 }}"
              alt="{{ shop.name }}"
              class="ai-header-logo-{{ ai_gen_id }}"
              width="{{ block.settings.logo_width }}"
              height="auto"
              loading="lazy"
            >
          </a>
        {% else %}
          <div class="ai-header-logo-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      {% elsif block.settings.middle_content_type == 'text' %}
        {{ block.settings.middle_text }}
      {% endif %}
    </div>

    <div class="ai-header-section-{{ ai_gen_id }} ai-header-right-{{ ai_gen_id }}">
      {% if block.settings.right_content_type == 'text' %}
        {{ block.settings.right_text }}
      {% elsif block.settings.right_content_type == 'navigation' %}
        <nav>
          <ul class="ai-header-nav-{{ ai_gen_id }}">
            {% if block.settings.right_link_1_text != blank %}
              <li>
                <a href="{{ block.settings.right_link_1_url }}">{{ block.settings.right_link_1_text }}</a>
              </li>
            {% endif %}
            {% if block.settings.right_link_2_text != blank %}
              <li>
                <a href="{{ block.settings.right_link_2_url }}">{{ block.settings.right_link_2_text }}</a>
              </li>
            {% endif %}
            {% if block.settings.right_link_3_text != blank %}
              <li>
                <a href="{{ block.settings.right_link_3_url }}">{{ block.settings.right_link_3_text }}</a>
              </li>
            {% endif %}
          </ul>
        </nav>
      {% endif %}
    </div>
  </div>
</header-block-{{ ai_gen_id }}>

<script>
  (function() {
    class HeaderBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('header-block-{{ ai_gen_id }}', HeaderBlock{{ ai_gen_id }});
  })();
</script>

