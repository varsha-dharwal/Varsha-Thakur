{% doc %}
  @prompt
    Create a custom Shopify section named "custom-banner.liquid" from scratch. Do not use any prebuilt Dawn sections or components. Use only Liquid, HTML, CSS, and vanilla JavaScript (no jQuery).
    
    The banner must be divided into 3 main parts:
    
    --------------------------------------------------
    
    1. Top Bar (3-column layout with logo)
    
    - Left: PNG logo image (upload via Shopify customizer)
    - Center: small message text (e.g., "Find the ideal gift for your loved ones.")
    - Right: CTA button (e.g., "CHOOSE GIFT") with arrow icon
    - Desktop layout: 3 columns (left, center, right)
    - Mobile layout: stacked and centered
    - Add smooth hover animation on button (translate + arrow move)
    - Logo must be uploaded via image_picker setting
    
    --------------------------------------------------
    
    2. Hero Section (Split Layout)
    
    This section must be divided into TWO PARTS:
    
    (A) Top Hero Area:
    - Full-width background image (selectable from customizer)
    - Acts as visual banner top
    - No text here, only background display
    
    (B) Bottom Split Area:
    - Two-column layout
    
    Left Side:
    - Heading (e.g., "The Gift Guide")
    - Description text
    - CTA button (e.g., "SHOP NOW")
    - Button hover animation
    
    Right Side:
    - Background image or image block (selectable from customizer)
    
    - Ensure alignment and spacing is clean and pixel-perfect
    - Make layout responsive:
      - Desktop: 2 columns
      - Mobile: stacked
    
    --------------------------------------------------
    
    3. Bottom Strip Section
    
    - Thin horizontal strip below hero
    - Center aligned uppercase text
    - Example:
      "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    
    --------------------------------------------------
    
    Technical Requirements:
    
    - Everything must be inside ONE Shopify section file
    - All text and images must be editable via schema settings
    - Add settings for:
      - logo image (PNG)
      - top message
      - top button label + link
      - top background image
      - bottom right image
      - heading
      - description
      - main button label + link
      - bottom strip text
      - colors (optional)
    
    - Use semantic CSS class naming
    - Add proper spacing, alignment, and typography
    - Add responsive CSS (desktop + mobile)
    - Use CSS transitions for animations (no JS needed for buttons)
    - Ensure pixel-perfect layout as per design
    - Code must be clean, structured, and production-ready
    
    --------------------------------------------------
    
    IMPORTANT POINTS (Must follow):
    
    - Do NOT use any existing Dawn section
    - Do NOT use jQuery
    - Build everything from scratch
    - All content must be dynamic (editable in customizer)
    - Keep code modular and readable
    - Optimize image usage (use image_url filter)
    - Ensure fast loading and clean UI
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
    .custom-banner-{{ ai_gen_id }} {
      display: block;
      width: 100%;
      max-width: 1440px;
    margin: auto;
    }

    .custom-banner__top-bar-{{ ai_gen_id }} {
      display: grid;
      grid-template-columns: 1fr 2fr 1fr;
      align-items: center;
      gap: 20px;
      height: 64px;
      padding: {{ block.settings.top_bar_padding }}px {{ block.settings.horizontal_padding }}px;
      background-color: {{ block.settings.top_bar_bg_color }};
    }

    .custom-banner__logo-{{ ai_gen_id }} {
      display: flex;
      justify-content: flex-start;
    }

    .custom-banner__logo-{{ ai_gen_id }} img {
      max-width: {{ block.settings.logo_width }}px;
      height: auto;
    }

    .custom-banner__message-{{ ai_gen_id }} {
      text-align: center;
      color: {{ block.settings.top_message_color }};
      font-size: {{ block.settings.top_message_size }}px;
    }

    .custom-banner__top-cta-{{ ai_gen_id }} {
      display: flex;
      justify-content: flex-end;
    }

    .custom-banner__top-button-{{ ai_gen_id }} {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 220px;
    height: 50px;
    gap: 10px;
    text-decoration: none;
    font-size: {{ block.settings.top_button_font_size }}px;
    color: #ffffff;
    background-color: #000000;
    overflow: hidden;
    transition: color 0.3s ease;
  }

  /* Sliding yellow layer */
  .custom-banner__top-button-{{ ai_gen_id }}::before {
    content: "";
    position: absolute;
    inset: 0;
    background-color: #FFF544;
    transform: translateX(-100%);
    transition: transform 0.4s ease;
    z-index: 0;
  }

  /* Text above overlay */
  .custom-banner__top-button-{{ ai_gen_id }} span {
    position: relative;
    z-index: 1;
  }

  /* Hover animation */
  .custom-banner__top-button-{{ ai_gen_id }}:hover::before {
    transform: translateX(0);
  }

  /* Text color change */
  .custom-banner__top-button-{{ ai_gen_id }}:hover {
    color: #000000;
  }

  /* Arrow animation */
  .custom-banner__arrow-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    transition: transform 0.3s ease;
  }

  .custom-banner__top-button-{{ ai_gen_id }}:hover .custom-banner__arrow-{{ ai_gen_id }} {
    transform: translateX(5px);
  }

  .custom-banner__top-button-{{ ai_gen_id }}:hover span,
  .custom-banner__top-button-{{ ai_gen_id }}:hover .custom-banner__arrow-{{ ai_gen_id }} {
    color: #000000;
  }

    .custom-banner__arrow-{{ ai_gen_id }} {
      transition: transform 0.3s ease;
    }

    .custom-banner__hero-{{ ai_gen_id }} {
      position: relative;
    }

    .custom-banner__hero-top-{{ ai_gen_id }} {
      width: 100%;
      height: {{ block.settings.hero_top_height }}px;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }

    .custom-banner__hero-bottom-{{ ai_gen_id }} {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
    }

    .custom-banner__hero-left-{{ ai_gen_id }} {
      display: flex;
      flex-direction: column;
      padding-bottom:0 !important;
      padding: {{ block.settings.hero_content_padding }}px;
      background-color: {{ block.settings.hero_left_bg }};
    }

    .custom-banner__hero-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.hero_heading_size }}px;
      color: {{ block.settings.hero_heading_color }};
      margin: 0 0 20px 0;
      line-height: 1.2;
    }

    .custom-banner__hero-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.hero_description_size }}px;
      color: {{ block.settings.hero_description_color }};
      margin: 0 0 50px 0;
      line-height: 1.4;
      max-width:483px;

    }

  /* ===============================
     HERO BUTTON (SHOP NOW)
  ================================ */

  .custom-banner__hero-button-{{ ai_gen_id }} {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 220px;
    height: 50px;
    gap: 10px;
    text-decoration: none;
    font-size: {{ block.settings.hero_button_font_size }}px;
    color: #ffffff;
    background-color: #000000;
    overflow: hidden;
    transition: color 0.3s ease;
  }

  /* 🔥 Yellow sliding layer */
  .custom-banner__hero-button-{{ ai_gen_id }}::before {
    content: "";
    position: absolute;
    inset: 0;
    background-color: #FFF544;
    transform: translateX(-100%);
    transition: transform 0.4s ease;
    z-index: 0;
  }

  /* Content above layer */
  .custom-banner__hero-button-{{ ai_gen_id }} span {
    position: relative;
    z-index: 1;
  }

  /* Hover: yellow slide */
  .custom-banner__hero-button-{{ ai_gen_id }}:hover::before {
    transform: translateX(0);
  }

  /* Hover: text black */
  .custom-banner__hero-button-{{ ai_gen_id }}:hover {
    color: #000000;
  }

  /* Arrow base */
  .custom-banner__hero-arrow-{{ ai_gen_id }} {
    color: inherit;
    transition: transform 0.3s ease;
  }

  /* Arrow move */
  .custom-banner__hero-button-{{ ai_gen_id }}:hover .custom-banner__hero-arrow-{{ ai_gen_id }} {
    transform: translateX(5px);
  }

  /* Ensure text + arrow black */
  .custom-banner__hero-button-{{ ai_gen_id }}:hover span,
  .custom-banner__hero-button-{{ ai_gen_id }}:hover .custom-banner__hero-arrow-{{ ai_gen_id }} {
    color: #000000;
  }

    .custom-banner__hero-right-{{ ai_gen_id }} {
      width: 100%;
    background-size: contain;
    background-repeat: no-repeat;
    }

    .custom-banner__bottom-strip-{{ ai_gen_id }} {
      heigh:34px;
      background-color: {{ block.settings.bottom_strip_bg }};
      text-align: center;
    }

    .custom-banner__bottom-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.bottom_strip_font_size }}px;
      color: {{ block.settings.bottom_strip_color }};
      text-transform: uppercase;
      letter-spacing: 1px;
      margin: 0;
    }

    @media screen and (max-width: 768px) {
      .custom-banner__top-bar-{{ ai_gen_id }} {
        grid-template-columns: 1fr;
        text-align: center;
        gap: 15px;
      }

      .custom-banner__logo-{{ ai_gen_id }},
      .custom-banner__top-cta-{{ ai_gen_id }} {
        justify-content: center;
      }

      .custom-banner__hero-bottom-{{ ai_gen_id }} {
        grid-template-columns: 1fr;
      }

      .custom-banner__hero-right-{{ ai_gen_id }} {
        height: 300px;
      }

      .custom-banner__hero-heading-{{ ai_gen_id }} {
        font-size: calc({{ block.settings.hero_heading_size }}px * 0.7);
      }

      .custom-banner__hero-description-{{ ai_gen_id }} {
        font-size: calc({{ block.settings.hero_description_size }}px * 0.9);
      }

      .custom-banner__bottom-text-{{ ai_gen_id }} {
        font-size: calc({{ block.settings.bottom_strip_font_size }}px * 0.85);
      }
    }
{% endstyle %}

<custom-banner-{{ ai_gen_id }} class="custom-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="custom-banner__top-bar-{{ ai_gen_id }}">
    <div class="custom-banner__logo-{{ ai_gen_id }}">
      {% if block.settings.logo %}
        <img
          src="{{ block.settings.logo | image_url: width: 400 }}"
          alt="{{ block.settings.logo.alt | escape }}"
          width="{{ block.settings.logo_width }}"
          height="auto"
          loading="lazy"
        >
      {% else %}
        <div class="custom-banner__logo-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="custom-banner__message-{{ ai_gen_id }}">
      {{ block.settings.top_message }}
    </div>

    <div class="custom-banner__top-cta-{{ ai_gen_id }}">
      <a
        href="{{ block.settings.top_button_link }}"
        class="custom-banner__top-button-{{ ai_gen_id }}"
      >
        <span class="custom-banner__text-{{ ai_gen_id }}">
          {{ block.settings.top_button_label }}
        </span>
      </a>
    </div>
  </div>

  <div class="custom-banner__hero-{{ ai_gen_id }}">
    <div
      class="custom-banner__hero-top-{{ ai_gen_id }}"
      {% if block.settings.hero_top_image %}
        style="background-image: url('{{ block.settings.hero_top_image | image_url: width: 2000 }}');"
      {% endif %}
    >
      {% unless block.settings.hero_top_image %}
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      {% endunless %}
    </div>

    <div class="custom-banner__hero-bottom-{{ ai_gen_id }}">
      <div class="custom-banner__hero-left-{{ ai_gen_id }}">
        {% if block.settings.hero_heading != blank %}
          <h2 class="custom-banner__hero-heading-{{ ai_gen_id }}">
            {{ block.settings.hero_heading }}
          </h2>
        {% endif %}

        {% if block.settings.hero_description != blank %}
          <div class="custom-banner__hero-description-{{ ai_gen_id }}">
            {{ block.settings.hero_description }}
          </div>
        {% endif %}

        <a
          href="{{ block.settings.hero_button_link }}"
          class="custom-banner__hero-button-{{ ai_gen_id }}"
        >
          <span>{{ block.settings.hero_button_label }}</span>
        </a>
      </div>

      <div
        class="custom-banner__hero-right-{{ ai_gen_id }}"
        {% if block.settings.hero_bottom_right_image %}
          style="background-image: url('{{ block.settings.hero_bottom_right_image | image_url: width: 1500 }}');"
        {% endif %}
      >
        {% unless block.settings.hero_bottom_right_image %}
          {{ 'collection-apparel-1' | placeholder_svg_tag }}
        {% endunless %}
      </div>
    </div>
  </div>

  <div class="custom-banner__bottom-strip-{{ ai_gen_id }}">
    <p class="custom-banner__bottom-text-{{ ai_gen_id }}">
      {{ block.settings.bottom_strip_text }}
    </p>
  </div>
</custom-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class CustomBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initBanner();
      }

      initBanner() {
        const buttons = this.querySelectorAll('a[href=""]');
        buttons.forEach(button => {
          button.addEventListener('click', (e) => {
            if (!button.getAttribute('href') || button.getAttribute('href') === '') {
              e.preventDefault();
            }
          });
        });
      }
    }

    customElements.define('custom-banner-{{ ai_gen_id }}', CustomBanner{{ ai_gen_id }});
  })();
</script>

