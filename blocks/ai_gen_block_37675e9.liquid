{% doc %}
  @prompt
    Create a custom Shopify section named "custom-banner.liquid" from scratch. Do not use any prebuilt Dawn sections or components. Use only Liquid, HTML, CSS, and vanilla JavaScript (no jQuery).
    
    The banner must be divided into 3 main parts:
    
    --------------------------------------------------
    
    1. Top Bar (3-column layout with logo)
    
    - Left: PNG logo image (upload via Shopify customizer)
    - Center: small message text (e.g., "Find the ideal gift for your loved ones.")
    - Right: CTA button (e.g., "CHOOSE GIFT") with arrow icon
    - Desktop layout: 3 columns (left, center, right)
    - Mobile layout: stacked and centered
    - Add smooth hover animation on button (translate + arrow move)
    - Logo must be uploaded via image_picker setting
    
    --------------------------------------------------
    
    2. Hero Section (Split Layout)
    
    This section must be divided into TWO PARTS:
    
    (A) Top Hero Area:
    - Full-width background image (selectable from customizer)
    - Acts as visual banner top
    - No text here, only background display
    
    (B) Bottom Split Area:
    - Two-column layout
    
    Left Side:
    - Heading (e.g., "The Gift Guide")
    - Description text
    - CTA button (e.g., "SHOP NOW")
    - Button hover animation
    
    Right Side:
    - Background image or image block (selectable from customizer)
    
    - Ensure alignment and spacing is clean and pixel-perfect
    - Make layout responsive:
      - Desktop: 2 columns
      - Mobile: stacked
    
    --------------------------------------------------
    
    3. Bottom Strip Section
    
    - Thin horizontal strip below hero
    - Center aligned uppercase text
    - Example:
      "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    
    --------------------------------------------------
    
    Technical Requirements:
    
    - Everything must be inside ONE Shopify section file
    - All text and images must be editable via schema settings
    - Add settings for:
      - logo image (PNG)
      - top message
      - top button label + link
      - top background image
      - bottom right image
      - heading
      - description
      - main button label + link
      - bottom strip text
      - colors (optional)
    
    - Use semantic CSS class naming
    - Add proper spacing, alignment, and typography
    - Add responsive CSS (desktop + mobile)
    - Use CSS transitions for animations (no JS needed for buttons)
    - Ensure pixel-perfect layout as per design
    - Code must be clean, structured, and production-ready
    
    --------------------------------------------------
    
    IMPORTANT POINTS (Must follow):
    
    - Do NOT use any existing Dawn section
    - Do NOT use jQuery
    - Build everything from scratch
    - All content must be dynamic (editable in customizer)
    - Keep code modular and readable
    - Optimize image usage (use image_url filter)
    - Ensure fast loading and clean UI
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% assign section_id = section.id %}

{% style %}
  .custom-banner-{{ section_id }} {
    display: block;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    background: {{ section.settings.section_bg_color }};
  }

  .custom-banner__top-bar-{{ section_id }} {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 20px;
    padding: {{ section.settings.top_bar_padding }}px {{ section.settings.horizontal_padding }}px;
    background-color: {{ section.settings.top_bar_bg_color }};
  }

  .custom-banner__logo-wrap-{{ section_id }} {
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .custom-banner__logo-{{ section_id }} {
    display: block;
    max-width: 100%;
    height: auto;
    width: {{ section.settings.logo_width }}px;
  }

  .custom-banner__logo-placeholder-{{ section_id }} {
    width: {{ section.settings.logo_width }}px;
    max-width: 100%;
  }

  .custom-banner__message-{{ section_id }} {
    text-align: center;
    color: {{ section.settings.top_message_color }};
    font-size: {{ section.settings.top_message_size }}px;
    line-height: 1.4;
    margin: 0;
  }

  .custom-banner__top-cta-{{ section_id }} {
    display: flex;
    justify-content: flex-end;
  }

  .custom-banner__button-{{ section_id }} {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-width: 200px;
    min-height: 50px;
    padding: 14px 24px;
    text-decoration: none;
    overflow: hidden;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    border: 1px solid {{ section.settings.button_border_color }};
    transition: color 0.3s ease, transform 0.3s ease;
    font-size: 14px;
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .custom-banner__top-button-{{ section_id }} {
    font-size: {{ section.settings.top_button_font_size }}px;
    border-radius: {{ section.settings.top_button_radius }}px;
  }

  .custom-banner__hero-button-{{ section_id }} {
    font-size: {{ section.settings.hero_button_font_size }}px;
    border-radius: {{ section.settings.hero_button_radius }}px;
    align-self: flex-start;
  }

  .custom-banner__button-{{ section_id }}::before {
    content: "";
    position: absolute;
    inset: 0;
    background-color: {{ section.settings.button_hover_bg_color }};
    transform: translateX(-100%);
    transition: transform 0.35s ease;
    z-index: 0;
  }

  .custom-banner__button-{{ section_id }} span {
    position: relative;
    z-index: 1;
  }

  .custom-banner__button-{{ section_id }}:hover::before {
    transform: translateX(0);
  }

  .custom-banner__button-{{ section_id }}:hover {
    color: {{ section.settings.button_hover_text_color }};
    transform: translateY(-2px);
  }

  .custom-banner__arrow-{{ section_id }} {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .custom-banner__button-{{ section_id }}:hover .custom-banner__arrow-{{ section_id }} {
    transform: translateX(5px);
  }

  .custom-banner__hero-{{ section_id }} {
    width: 100%;
  }

  .custom-banner__hero-top-{{ section_id }} {
    width: 100%;
    height: {{ section.settings.hero_top_height }}px;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    overflow: hidden;
  }

  .custom-banner__hero-top-placeholder-{{ section_id }},
  .custom-banner__hero-right-placeholder-{{ section_id }} {
    width: 100%;
    height: 100%;
  }

  .custom-banner__hero-top-placeholder-{{ section_id }} svg,
  .custom-banner__hero-right-placeholder-{{ section_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .custom-banner__hero-bottom-{{ section_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    min-height: {{ section.settings.hero_bottom_height }}px;
  }

  .custom-banner__hero-left-{{ section_id }} {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: {{ section.settings.hero_content_padding }}px;
    background-color: {{ section.settings.hero_left_bg }};
  }

  .custom-banner__hero-heading-{{ section_id }} {
    font-size: {{ section.settings.hero_heading_size }}px;
    color: {{ section.settings.hero_heading_color }};
    margin: 0 0 20px;
    line-height: 1.05;
    font-weight: 500;
  }

  .custom-banner__hero-description-{{ section_id }} {
    font-size: {{ section.settings.hero_description_size }}px;
    color: {{ section.settings.hero_description_color }};
    margin: 0 0 36px;
    line-height: 1.6;
    max-width: 520px;
  }

  .custom-banner__hero-right-{{ section_id }} {
    min-height: {{ section.settings.hero_bottom_height }}px;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-color: {{ section.settings.hero_right_bg }};
  }

  .custom-banner__bottom-strip-{{ section_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ section.settings.bottom_strip_padding }}px {{ section.settings.horizontal_padding }}px;
    background-color: {{ section.settings.bottom_strip_bg }};
    text-align: center;
  }

  .custom-banner__bottom-text-{{ section_id }} {
    font-size: {{ section.settings.bottom_strip_font_size }}px;
    color: {{ section.settings.bottom_strip_color }};
    text-transform: uppercase;
    letter-spacing: 1px;
    line-height: 1.4;
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    .custom-banner__top-bar-{{ section_id }} {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 14px;
      padding: 16px 20px;
    }

    .custom-banner__logo-wrap-{{ section_id }},
    .custom-banner__top-cta-{{ section_id }} {
      justify-content: center;
    }

    .custom-banner__hero-top-{{ section_id }} {
      height: {{ section.settings.hero_top_height_mobile }}px;
    }

    .custom-banner__hero-bottom-{{ section_id }} {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .custom-banner__hero-right-{{ section_id }} {
      order: 1;
      min-height: {{ section.settings.hero_right_mobile_height }}px;
    }

    .custom-banner__hero-left-{{ section_id }} {
      order: 2;
      padding: 32px 20px;
      align-items: center;
      text-align: center;
    }

    .custom-banner__hero-button-{{ section_id }} {
      align-self: center;
    }

    .custom-banner__hero-heading-{{ section_id }} {
      font-size: calc({{ section.settings.hero_heading_size }}px * 0.62);
    }

    .custom-banner__hero-description-{{ section_id }} {
      font-size: calc({{ section.settings.hero_description_size }}px * 0.95);
      margin-bottom: 28px;
    }

    .custom-banner__bottom-text-{{ section_id }} {
      font-size: calc({{ section.settings.bottom_strip_font_size }}px * 0.92);
    }
  }
{% endstyle %}

<section class="custom-banner-{{ section_id }}" {{ section.shopify_attributes }}>
  <div class="custom-banner__top-bar-{{ section_id }}">
    <div class="custom-banner__logo-wrap-{{ section_id }}">
      {% if section.settings.logo != blank %}
        <img
          class="custom-banner__logo-{{ section_id }}"
          src="{{ section.settings.logo | image_url: width: 500 }}"
          alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
          loading="lazy"
          width="{{ section.settings.logo_width }}"
          height="auto"
        >
      {% else %}
        <div class="custom-banner__logo-placeholder-{{ section_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="custom-banner__message-{{ section_id }}">
      {{ section.settings.top_message }}
    </div>

    <div class="custom-banner__top-cta-{{ section_id }}">
      <a
        href="{{ section.settings.top_button_link | default: '#' }}"
        class="custom-banner__button-{{ section_id }} custom-banner__top-button-{{ section_id }}"
      >
        <span>{{ section.settings.top_button_label }}</span>
        <span class="custom-banner__arrow-{{ section_id }}">→</span>
      </a>
    </div>
  </div>

  <div class="custom-banner__hero-{{ section_id }}">
    <div
      class="custom-banner__hero-top-{{ section_id }}"
      {% if section.settings.hero_top_image != blank %}
        style="background-image: url('{{ section.settings.hero_top_image | image_url: width: 2200 }}');"
      {% endif %}
    >
      {% if section.settings.hero_top_image == blank %}
        <div class="custom-banner__hero-top-placeholder-{{ section_id }}">
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="custom-banner__hero-bottom-{{ section_id }}">
      <div class="custom-banner__hero-left-{{ section_id }}">
        {% if section.settings.hero_heading != blank %}
          <h2 class="custom-banner__hero-heading-{{ section_id }}">
            {{ section.settings.hero_heading }}
          </h2>
        {% endif %}

        {% if section.settings.hero_description != blank %}
          <div class="custom-banner__hero-description-{{ section_id }}">
            {{ section.settings.hero_description }}
          </div>
        {% endif %}

        {% if section.settings.hero_button_label != blank %}
          <a
            href="{{ section.settings.hero_button_link | default: '#' }}"
            class="custom-banner__button-{{ section_id }} custom-banner__hero-button-{{ section_id }}"
          >
            <span>{{ section.settings.hero_button_label }}</span>
            <span class="custom-banner__arrow-{{ section_id }}">→</span>
          </a>
        {% endif %}
      </div>

      <div
        class="custom-banner__hero-right-{{ section_id }}"
        {% if section.settings.hero_bottom_right_image != blank %}
          style="background-image: url('{{ section.settings.hero_bottom_right_image | image_url: width: 1800 }}');"
        {% endif %}
      >
        {% if section.settings.hero_bottom_right_image == blank %}
          <div class="custom-banner__hero-right-placeholder-{{ section_id }}">
            {{ 'collection-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="custom-banner__bottom-strip-{{ section_id }}">
    <p class="custom-banner__bottom-text-{{ section_id }}">
      {{ section.settings.bottom_strip_text }}
    </p>
  </div>
</section>

<script>
  (function() {
    class CustomBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initBanner();
      }

      initBanner() {
        const buttons = this.querySelectorAll('a[href=""]');
        buttons.forEach(button => {
          button.addEventListener('click', (e) => {
            if (!button.getAttribute('href') || button.getAttribute('href') === '') {
              e.preventDefault();
            }
          });
        });
      }
    }

    customElements.define('custom-banner-{{ ai_gen_id }}', CustomBanner{{ ai_gen_id }});
  })();
</script>


