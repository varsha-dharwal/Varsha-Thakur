{% assign ai_gen_id = section.id | replace: '_', '' | downcase %}

{% style %}
  .custom-banner-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    overflow: hidden;
    background: transparent;
  }

  .custom-banner__top-bar-{{ ai_gen_id }} {
    width: 100%;
    background: {{ section.settings.top_bar_bg_color }};
    border-bottom: 1px solid {{ section.settings.top_bar_border_color }};
  }

  .custom-banner__brand-text-{{ ai_gen_id }},
  .custom-banner__mobile-brand-{{ ai_gen_id }},
  .custom-banner__mobile-panel-brand-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #111111;
  }

  .custom-banner__desktop-bar-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: minmax(160px, 1fr) auto minmax(180px, 1fr);
    align-items: center;
    gap: 20px;
    min-height: 64px;
    padding: {{ section.settings.top_bar_padding }}px {{ section.settings.horizontal_padding }}px;
    background-color: {{ section.settings.top_bar_bg_color }};
  }

  .custom-banner__desktop-logo-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    min-width: 160px;
    overflow: visible;
  }

  .custom-banner__desktop-logo-{{ ai_gen_id }} img {
    display: block;
    width: auto;
    max-width: {{ section.settings.logo_width }}px;
    height: auto;
    object-fit: contain;
  }

  .custom-banner__desktop-message-{{ ai_gen_id }} {
    text-align: center;
    color: {{ section.settings.top_message_color }};
    font-size: {{ section.settings.top_message_size }}px;
    line-height: 1.4;
    word-break: break-word;
  }

  .custom-banner__desktop-cta-{{ ai_gen_id }} {
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  .custom-banner__top-button-{{ ai_gen_id }},
  .custom-banner__hero-button-{{ ai_gen_id }} {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 48px;
    padding: 12px 22px;
    min-width: 220px;
    max-width: 100%;
    text-decoration: none;
    line-height: 1;
    text-transform: uppercase;
    overflow: hidden;
    transition: color 0.3s ease, transform 0.25s ease;
    white-space: nowrap;
    border: none;
  }

  .custom-banner__top-button-{{ ai_gen_id }} {
    background: {{ section.settings.top_button_bg }};
    color: {{ section.settings.top_button_text_color }};
    font-size: {{ section.settings.top_button_font_size }}px;
    border-radius: {{ section.settings.top_button_radius }}px;
  }

  .custom-banner__hero-button-{{ ai_gen_id }} {
    background: {{ section.settings.hero_button_bg }};
    color: {{ section.settings.hero_button_text_color }};
    font-size: {{ section.settings.hero_button_font_size }}px;
    border-radius: {{ section.settings.hero_button_radius }}px;
  }

  .custom-banner__top-button-{{ ai_gen_id }}::before,
  .custom-banner__hero-button-{{ ai_gen_id }}::before {
    content: "";
    position: absolute;
    inset: 0;
    transform: translateX(-100%);
    transition: transform 0.35s ease;
    z-index: 0;
  }

  .custom-banner__top-button-{{ ai_gen_id }}::before {
    background: {{ section.settings.top_button_hover_bg }};
  }

  .custom-banner__hero-button-{{ ai_gen_id }}::before {
    background: {{ section.settings.hero_button_hover_bg }};
  }

  .custom-banner__top-button-{{ ai_gen_id }} span,
  .custom-banner__hero-button-{{ ai_gen_id }} span {
    position: relative;
    z-index: 1;
  }

  .custom-banner__top-button-{{ ai_gen_id }}:hover::before,
  .custom-banner__hero-button-{{ ai_gen_id }}:hover::before {
    transform: translateX(0);
  }

  .custom-banner__top-button-{{ ai_gen_id }}:hover,
  .custom-banner__hero-button-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
    color: #111111;
  }

  .custom-banner__arrow-{{ ai_gen_id }},
  .custom-banner__hero-arrow-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    transition: transform 0.25s ease;
    flex-shrink: 0;
    color: inherit;
  }

  .custom-banner__top-button-{{ ai_gen_id }}:hover .custom-banner__arrow-{{ ai_gen_id }},
  .custom-banner__hero-button-{{ ai_gen_id }}:hover .custom-banner__hero-arrow-{{ ai_gen_id }} {
    transform: translateX(4px);
  }

  .custom-banner__mobile-wrap-{{ ai_gen_id }} {
    display: none;
  }

  .custom-banner__mobile-trigger-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    min-height: 52px;
    padding: 14px 16px;
    border: 0;
    background: {{ section.settings.top_bar_bg_color }};
    cursor: pointer;
  }

  .custom-banner__mobile-logo-image-{{ ai_gen_id }} {
    display: block;
    max-width: 140px;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .custom-banner__menu-icon-{{ ai_gen_id }},
  .custom-banner__close-button-{{ ai_gen_id }} {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 20px;
    line-height: 1;
    color: {{ section.settings.top_icon_color }};
  }

  .custom-banner__close-button-{{ ai_gen_id }} {
    border: 0;
    background: transparent;
    cursor: pointer;
    padding: 0;
  }

  .custom-banner__mobile-panel-{{ ai_gen_id }} {
    padding: 0 0 16px;
    background: {{ section.settings.top_bar_bg_color }};
  }

  .custom-banner__mobile-panel-header-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 14px 16px;
    border-top: 1px solid {{ section.settings.top_bar_border_color }};
    box-shadow: 0 1px 0 {{ section.settings.top_bar_border_color }} inset;
  }

  .custom-banner__mobile-message-{{ ai_gen_id }} {
    margin-top: 14px;
    padding: 0 16px;
    text-align: center;
    color: {{ section.settings.top_message_color }};
    font-size: {{ section.settings.top_message_size }}px;
    line-height: 1.5;
    word-break: break-word;
  }

  .custom-banner__mobile-cta-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    margin-top: 16px;
    padding: 0 16px;
  }

  .custom-banner__hero-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .custom-banner__hero-top-{{ ai_gen_id }} {
    width: 100%;
    height: {{ section.settings.hero_top_height }}px;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .custom-banner__hero-top-{{ ai_gen_id }} svg,
  .custom-banner__hero-right-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .custom-banner__hero-bottom-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    gap: 0;
    min-height: {{ section.settings.hero_bottom_height }}px;
  }

  .custom-banner__hero-left-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: {{ section.settings.hero_content_padding }}px;
    background-color: {{ section.settings.hero_left_bg }};
    min-width: 0;
  }

  .custom-banner__hero-heading-{{ ai_gen_id }} {
    font-size: {{ section.settings.hero_heading_size }}px;
    color: {{ section.settings.hero_heading_color }};
    margin: 0 0 20px 0;
    line-height: 1.15;
    word-break: break-word;
  }

  .custom-banner__hero-description-{{ ai_gen_id }} {
    font-size: {{ section.settings.hero_description_size }}px;
    color: {{ section.settings.hero_description_color }};
    margin: 0 0 36px 0;
    line-height: 1.5;
    max-width: 483px;
    width: 100%;
    word-break: break-word;
  }

  .custom-banner__hero-right-{{ ai_gen_id }} {
    width: 100%;
    min-height: {{ section.settings.hero_bottom_height }}px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    background-color: transparent;
  }

  .custom-banner__bottom-strip-{{ ai_gen_id }} {
    padding: {{ section.settings.bottom_strip_padding }}px {{ section.settings.horizontal_padding }}px;
    background-color: {{ section.settings.bottom_strip_bg }};
    text-align: center;
  }

  .custom-banner__bottom-text-{{ ai_gen_id }} {
    font-size: {{ section.settings.bottom_strip_font_size }}px;
    color: {{ section.settings.bottom_strip_color }};
    text-transform: uppercase;
    letter-spacing: 1px;
    line-height: 1.4;
    margin: 0;
    word-break: break-word;
  }

  @media screen and (max-width: 1199px) {
    .custom-banner__hero-left-{{ ai_gen_id }} {
      padding: 40px;
    }

    .custom-banner__hero-heading-{{ ai_gen_id }} {
      font-size: calc({{ section.settings.hero_heading_size }}px * 0.82);
    }

    .custom-banner__hero-description-{{ ai_gen_id }} {
      font-size: calc({{ section.settings.hero_description_size }}px * 0.95);
    }

    .custom-banner__top-button-{{ ai_gen_id }},
    .custom-banner__hero-button-{{ ai_gen_id }} {
      min-width: 190px;
      padding: 12px 20px;
    }
  }

  @media screen and (max-width: 1024px) {
    .custom-banner__desktop-bar-{{ ai_gen_id }} {
      display: none;
    }

    .custom-banner__mobile-wrap-{{ ai_gen_id }} {
      display: block;
    }
  }

  @media screen and (min-width: 1025px) {
    .custom-banner__desktop-bar-{{ ai_gen_id }} {
      display: grid;
    }

    .custom-banner__mobile-wrap-{{ ai_gen_id }} {
      display: none;
    }
  }

  @media screen and (max-width: 989px) {
    .custom-banner__hero-bottom-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .custom-banner__hero-right-{{ ai_gen_id }} {
      order: 1;
      min-height: 420px;
      background-size: contain;
      background-position: center;
    }

    .custom-banner__hero-left-{{ ai_gen_id }} {
      order: 2;
      align-items: center;
      text-align: center;
      padding: 36px 28px;
    }

    .custom-banner__hero-description-{{ ai_gen_id }} {
      max-width: 680px;
    }

    .custom-banner__hero-button-{{ ai_gen_id }} {
      align-self: center;
    }
  }

  @media screen and (max-width: 767px) {
    .custom-banner-{{ ai_gen_id }} {
      max-width: 100%;
    }

    .custom-banner__hero-top-{{ ai_gen_id }} {
      height: calc({{ section.settings.hero_top_height }}px * 0.72);
      min-height: 180px;
    }

    .custom-banner__hero-left-{{ ai_gen_id }} {
      padding: 28px 18px;
    }

    .custom-banner__hero-right-{{ ai_gen_id }} {
      min-height: 280px;
      background-size: cover;
      background-position: center;
    }

    .custom-banner__hero-heading-{{ ai_gen_id }} {
      font-size: calc({{ section.settings.hero_heading_size }}px * 0.58);
      margin-bottom: 16px;
    }

    .custom-banner__hero-description-{{ ai_gen_id }} {
      font-size: calc({{ section.settings.hero_description_size }}px * 0.95);
      margin-bottom: 24px;
      max-width: 100%;
    }

    .custom-banner__top-button-{{ ai_gen_id }},
    .custom-banner__hero-button-{{ ai_gen_id }} {
      min-width: 100%;
      width: 100%;
      max-width: 280px;
      min-height: 48px;
      padding: 12px 18px;
    }

    .custom-banner__bottom-strip-{{ ai_gen_id }} {
      padding-left: 16px;
      padding-right: 16px;
    }

    .custom-banner__bottom-text-{{ ai_gen_id }} {
      font-size: calc({{ section.settings.bottom_strip_font_size }}px * 0.92);
      letter-spacing: 0.4px;
    }
  }

  @media screen and (max-width: 480px) {
    .custom-banner__mobile-brand-{{ ai_gen_id }},
    .custom-banner__mobile-panel-brand-{{ ai_gen_id }} {
      font-size: 15px;
    }

    .custom-banner__mobile-message-{{ ai_gen_id }} {
      font-size: calc({{ section.settings.top_message_size }}px * 0.95);
    }

    .custom-banner__top-button-{{ ai_gen_id }},
    .custom-banner__hero-button-{{ ai_gen_id }} {
      max-width: 100%;
      min-width: 0;
      font-size: 14px;
    }

    .custom-banner__hero-top-{{ ai_gen_id }} {
      min-height: 150px;
    }

    .custom-banner__hero-right-{{ ai_gen_id }} {
      min-height: 220px;
    }

    .custom-banner__hero-heading-{{ ai_gen_id }} {
      font-size: calc({{ section.settings.hero_heading_size }}px * 0.48);
    }

    .custom-banner__hero-description-{{ ai_gen_id }} {
      font-size: calc({{ section.settings.hero_description_size }}px * 0.9);
    }

    .custom-banner__bottom-text-{{ ai_gen_id }} {
      font-size: calc({{ section.settings.bottom_strip_font_size }}px * 0.85);
    }
  }
{% endstyle %}

<custom-banner-{{ ai_gen_id }} class="custom-banner-{{ ai_gen_id }}" {{ section.shopify_attributes }}>
  <div class="custom-banner__top-bar-{{ ai_gen_id }}">
    <div class="custom-banner__desktop-bar-{{ ai_gen_id }}">
      <div class="custom-banner__desktop-logo-{{ ai_gen_id }}">
        {% if section.settings.logo != blank %}
          <img
            src="{{ section.settings.logo | image_url: width: 400 }}"
            alt="{{ section.settings.logo.alt | escape }}"
            width="{{ section.settings.logo_width }}"
            height="auto"
            loading="lazy"
          >
        {% else %}
          <span class="custom-banner__brand-text-{{ ai_gen_id }}">
            {{ section.settings.logo_text }}
          </span>
        {% endif %}
      </div>

      <div class="custom-banner__desktop-message-{{ ai_gen_id }}">
        {{ section.settings.top_message }}
      </div>

      <div class="custom-banner__desktop-cta-{{ ai_gen_id }}">
        <a
          href="{{ section.settings.top_button_link | default: '#' }}"
          class="custom-banner__top-button-{{ ai_gen_id }}"
        >
          <span>{{ section.settings.top_button_label }}</span>
          <span class="custom-banner__arrow-{{ ai_gen_id }}">→</span>
        </a>
      </div>
    </div>

    <div class="custom-banner__mobile-wrap-{{ ai_gen_id }}">
      <button
        type="button"
        class="custom-banner__mobile-trigger-{{ ai_gen_id }}"
        aria-expanded="false"
        aria-controls="custom-banner-mobile-panel-{{ ai_gen_id }}"
      >
        <span class="custom-banner__menu-icon-{{ ai_gen_id }}">☰</span>

        {% if section.settings.logo != blank %}
          <img
            src="{{ section.settings.logo | image_url: width: 300 }}"
            alt="{{ section.settings.logo.alt | escape }}"
            width="{{ section.settings.logo_width }}"
            height="auto"
            loading="lazy"
            class="custom-banner__mobile-logo-image-{{ ai_gen_id }}"
          >
        {% else %}
          <span class="custom-banner__mobile-brand-{{ ai_gen_id }}">
            {{ section.settings.logo_text }}
          </span>
        {% endif %}
      </button>

      <div
        id="custom-banner-mobile-panel-{{ ai_gen_id }}"
        class="custom-banner__mobile-panel-{{ ai_gen_id }}"
        hidden
      >
        <div class="custom-banner__mobile-panel-header-{{ ai_gen_id }}">
          <button
            type="button"
            class="custom-banner__close-button-{{ ai_gen_id }}"
            aria-label="Close menu"
          >
            ✕
          </button>

          {% if section.settings.logo != blank %}
            <img
              src="{{ section.settings.logo | image_url: width: 300 }}"
              alt="{{ section.settings.logo.alt | escape }}"
              width="{{ section.settings.logo_width }}"
              height="auto"
              loading="lazy"
              class="custom-banner__mobile-logo-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="custom-banner__mobile-panel-brand-{{ ai_gen_id }}">
              {{ section.settings.logo_text }}
            </div>
          {% endif %}
        </div>

        <div class="custom-banner__mobile-message-{{ ai_gen_id }}">
          {{ section.settings.top_message }}
        </div>

        <div class="custom-banner__mobile-cta-{{ ai_gen_id }}">
          <a
            href="{{ section.settings.top_button_link | default: '#' }}"
            class="custom-banner__top-button-{{ ai_gen_id }}"
          >
            <span>{{ section.settings.top_button_label }}</span>
            <span class="custom-banner__arrow-{{ ai_gen_id }}">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="custom-banner__hero-{{ ai_gen_id }}">
    <div
      class="custom-banner__hero-top-{{ ai_gen_id }}"
      {% if section.settings.hero_top_image != blank %}
        style="background-image: url('{{ section.settings.hero_top_image | image_url: width: 2000 }}');"
      {% endif %}
    >
      {% unless section.settings.hero_top_image != blank %}
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      {% endunless %}
    </div>

    <div class="custom-banner__hero-bottom-{{ ai_gen_id }}">
      <div class="custom-banner__hero-left-{{ ai_gen_id }}">
        {% if section.settings.hero_heading != blank %}
          <h2 class="custom-banner__hero-heading-{{ ai_gen_id }}">
            {{ section.settings.hero_heading }}
          </h2>
        {% endif %}

        {% if section.settings.hero_description != blank %}
          <div class="custom-banner__hero-description-{{ ai_gen_id }}">
            {{ section.settings.hero_description }}
          </div>
        {% endif %}

        {% if section.settings.hero_button_label != blank %}
          <a
            href="{{ section.settings.hero_button_link | default: '#' }}"
            class="custom-banner__hero-button-{{ ai_gen_id }}"
          >
            <span>{{ section.settings.hero_button_label }}</span>
            <span class="custom-banner__hero-arrow-{{ ai_gen_id }}">→</span>
          </a>
        {% endif %}
      </div>

      <div
        class="custom-banner__hero-right-{{ ai_gen_id }}"
        {% if section.settings.hero_bottom_right_image != blank %}
          style="background-image: url('{{ section.settings.hero_bottom_right_image | image_url: width: 1500 }}');"
        {% endif %}
      >
        {% unless section.settings.hero_bottom_right_image != blank %}
          {{ 'collection-apparel-1' | placeholder_svg_tag }}
        {% endunless %}
      </div>
    </div>
  </div>

  <div class="custom-banner__bottom-strip-{{ ai_gen_id }}">
    <p class="custom-banner__bottom-text-{{ ai_gen_id }}">
      {{ section.settings.bottom_strip_text }}
    </p>
  </div>
</custom-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class CustomBanner{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.initBanner();
      }

      initBanner() {
        this.handleEmptyLinks();
        this.handleMobileToggle();
      }

      handleEmptyLinks() {
        const links = this.querySelectorAll('a');
        links.forEach((link) => {
          link.addEventListener('click', (e) => {
            const href = link.getAttribute('href');
            if (!href || href.trim() === '') {
              e.preventDefault();
            }
          });
        });
      }

      handleMobileToggle() {
        const trigger = this.querySelector('.custom-banner__mobile-trigger-{{ ai_gen_id }}');
        const panel = this.querySelector('.custom-banner__mobile-panel-{{ ai_gen_id }}');
        const closeBtn = this.querySelector('.custom-banner__close-button-{{ ai_gen_id }}');

        if (!trigger || !panel || !closeBtn) return;

        trigger.addEventListener('click', () => {
          panel.hidden = false;
          trigger.hidden = true;
          trigger.setAttribute('aria-expanded', 'true');
        });

        closeBtn.addEventListener('click', () => {
          panel.hidden = true;
          trigger.hidden = false;
          trigger.setAttribute('aria-expanded', 'false');
        });
      }
    }

    if (!customElements.get('custom-banner-{{ ai_gen_id }}')) {
      customElements.define('custom-banner-{{ ai_gen_id }}', CustomBanner{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Custom banner",
  "settings": [
    {
      "type": "header",
      "content": "Top bar"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "TISSO VISION"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 120
    },
    {
      "type": "text",
      "id": "top_message",
      "label": "Message",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "range",
      "id": "top_message_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Message font size",
      "default": 14
    },
    {
      "type": "text",
      "id": "top_button_label",
      "label": "Button label",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "top_button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "top_button_font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Button font size",
      "default": 14
    },
    {
      "type": "range",
      "id": "top_button_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Button border radius",
      "default": 4
    },
    {
      "type": "range",
      "id": "top_bar_padding",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Vertical padding",
      "default": 20
    },
    {
      "type": "header",
      "content": "Top bar colors"
    },
    {
      "type": "color",
      "id": "top_bar_bg_color",
      "label": "Background",
      "default": "#f3f3f3"
    },
    {
      "type": "color",
      "id": "top_bar_border_color",
      "label": "Border color",
      "default": "#d9d9d9"
