<div class="custom-grid-section">
  <div class="page-width">
    <h2>{{ section.settings.heading }}</h2>

    <div class="custom-grid">
      {% for block in section.blocks %}
        <div class="custom-grid-item" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 800 }}"
              alt="{{ block.settings.title | escape }}"
              width="400"
              height="auto"
            >
          {% endif %}

          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% style %}
  .custom-grid-section {
    padding: 60px 20px;
  }

  .custom-grid-section .page-width {
    max-width: 1200px;
    margin: 0 auto;
  }

  .custom-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .custom-grid-item img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media screen and (max-width: 768px) {
    .custom-grid {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Custom Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Grid Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Category description"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Custom Grid"
    }
  ]
}
{% endschema %}