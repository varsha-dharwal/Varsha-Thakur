{% assign grid_id = section.id | replace: '_', '' | downcase %}

{% style %}
.custom-grid-section-{{ grid_id }} {
  background: {{ section.settings.section_bg }};
  padding: {{ section.settings.section_padding_top }}px {{ section.settings.section_padding_horizontal }}px {{ section.settings.section_padding_bottom }}px;
}

.custom-grid__inner-{{ grid_id }} {
  max-width: {{ section.settings.page_width }}px;
  margin: 0 auto;
}

.custom-grid__heading-{{ grid_id }} {
  margin: 0 0 28px;
  font-size: {{ section.settings.heading_size }}px;
  line-height: 1.1;
  color: {{ section.settings.heading_color }};
  font-weight: 400;
}

.custom-grid__list-{{ grid_id }} {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: {{ section.settings.grid_gap }}px;
}

.custom-grid__card-{{ grid_id }} {
  position: relative;
  display: block;
  width: 100%;
  background: transparent;
  padding: 0;
  margin: 0;
  cursor: pointer;
  text-align: left;
  border: 0;
}

.custom-grid__media-wrap-{{ grid_id }} {
  position: relative;
  width: 100%;
  aspect-ratio: 0.79;
  overflow: hidden;
  background: #f2f2f2;
}

.custom-grid__media-wrap-{{ grid_id }} img,
.custom-grid__media-wrap-{{ grid_id }} svg {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.custom-grid__hotspot-{{ grid_id }} {
  position: absolute;
  transform: translate(-50%, -50%);
  width: 24px;
  height: 24px;
  border-radius: 999px;
  border: 0;
  background: rgba(248, 248, 248, 0.9);
  color: #111111;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  line-height: 1;
  box-shadow: 0 1px 8px rgba(0,0,0,0.12);
  pointer-events: none;
}

.custom-grid__card-{{ grid_id }}:hover {
  transform: translateY(-4px);
}

.custom-grid__card-{{ grid_id }}:hover .custom-grid__media-wrap-{{ grid_id }} img,
.custom-grid__card-{{ grid_id }}:hover .custom-grid__media-wrap-{{ grid_id }} svg {
  transform: scale(1.04);
}

.custom-grid__card-{{ grid_id }}:hover .custom-grid__hotspot-{{ grid_id }} {
  transform: translate(-50%, -50%) scale(1.08);
  box-shadow: 0 6px 16px rgba(0,0,0,0.16);
}

.custom-grid__modal-{{ grid_id }}[hidden] {
  display: none !important;
}

.custom-grid__modal-{{ grid_id }} {
  position: fixed;
  inset: 0;
  z-index: 999;
}

.custom-grid__overlay-{{ grid_id }} {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.18);
}

.custom-grid__dialog-{{ grid_id }} {
  position: relative;
  z-index: 1;
  width: min(100% - 12px, 320px);
  margin: 4px auto;
  background: {{ section.settings.modal_bg }};
  color: {{ section.settings.modal_text_color }};
  border: 1px solid #cfc8bf;
  padding: 14px 14px 18px;
  max-height: calc(100vh - 8px);
  overflow-y: auto;
}

.custom-grid__close-{{ grid_id }} {
  position: absolute;
  top: 10px;
  right: 12px;
  width: 24px;
  height: 24px;
  border: 0;
  background: transparent;
  color: {{ section.settings.modal_text_color }};
  font-size: 22px;
  line-height: 1;
  cursor: pointer;
  padding: 0;
}

.custom-grid__modal-content-{{ grid_id }} {
  display: grid;
  grid-template-columns: 88px 1fr;
  gap: 12px;
  align-items: start;
  padding-top: 12px;
}

.custom-grid__modal-image-{{ grid_id }} {
  width: 88px;
  aspect-ratio: 0.82;
  overflow: hidden;
  background: #ebe6de;
}

.custom-grid__modal-image-{{ grid_id }} img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.custom-grid__modal-details-{{ grid_id }} {
  min-width: 0;
  display: grid;
  gap: 12px;
}

.custom-grid__product-title-{{ grid_id }} {
  margin: 0 0 10px;
  font-size: 22px;
  line-height: 1.08;
  font-weight: 400;
  color: {{ section.settings.modal_text_color }};
}

.custom-grid__price-{{ grid_id }} {
  margin: 0 0 10px;
  font-size: 15px;
  line-height: 1.15;
  color: {{ section.settings.modal_text_color }};
}

.custom-grid__description-{{ grid_id }} {
  margin: 0 0 14px;
  font-size: 12px;
  line-height: 1.25;
  color: #5d5953;
  max-width: 100%;
}

.custom-grid__options-wrap-{{ grid_id }} {
  display: grid;
  grid-auto-flow: row;
  gap: 16px;
  width: 100%;
}

.custom-grid__options-color-wrap-{{ grid_id }},
.custom-grid__options-size-wrap-{{ grid_id }} {
  width: 100%;
  display: grid;
  gap: 14px;
}

.custom-grid__option-group-{{ grid_id }} {
  width: 100%;
  display: grid;
  gap: 8px;
}

.custom-grid__option-label-{{ grid_id }} {
  display: block;
  margin-bottom: 10px;
  font-size: 12px;
  line-height: 1.2;
  color: {{ section.settings.modal_text_color }};
}

.custom-grid__pill-list-{{ grid_id }} {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  width: 100%;
  border: 1px solid #9a948c;
  border-radius: 0;
  background: transparent;
  overflow: hidden;
}

.custom-grid__pill-{{ grid_id }} {
  appearance: none;
  border: 0;
  border-right: 1px solid #9a948c;
  background: transparent;
  color: {{ section.settings.modal_text_color }};
  width: 100%;
  padding: 10px 12px;
  cursor: pointer;
  font-size: 13px;
  line-height: 1.2;
  text-align: left;
}

.custom-grid__pill-{{ grid_id }}:last-child {
  border-right: 0;
}

.custom-grid__pill-{{ grid_id }}.is-active {
  background: #111111;
  color: #ffffff;
}

.custom-grid__dropdown-{{ grid_id }} {
  position: relative;
  width: 100%;
}

.custom-grid__dropdown-trigger-{{ grid_id }} {
  width: 100%;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1px solid #9a948c;
  background: #f3f0ea;
  color: #111111;
  padding: 0 0 0 12px;
  font-size: 13px;
  cursor: pointer;
  box-sizing: border-box;
}

.custom-grid__dropdown-label-{{ grid_id }} {
  flex: 1;
  text-align: left;
}

.custom-grid__dropdown-arrow-{{ grid_id }} {
  width: 44px;
  min-height: 44px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-left: 1px solid #9a948c;
  font-size: 16px;
  transition: transform 0.2s ease;
}

.custom-grid__dropdown-{{ grid_id }}.is-open .custom-grid__dropdown-arrow-{{ grid_id }} {
  transform: rotate(180deg);
}

.custom-grid__dropdown-menu-{{ grid_id }}[hidden] {
  display: none !important;
}

.custom-grid__dropdown-menu-{{ grid_id }} {
  position: absolute;
  top: calc(100% - 1px);
  left: 0;
  width: 100%;
  border: 1px solid #9a948c;
  background: #f3f0ea;
  z-index: 30;
  max-height: 240px;
  overflow-y: auto;
}

.custom-grid__dropdown-item-{{ grid_id }} {
  width: 100%;
  border: 0;
  background: transparent;
  color: #111111;
  text-align: center;
  padding: 12px 14px;
  font-size: 14px;
  cursor: pointer;
}

.custom-grid__dropdown-item-{{ grid_id }}:hover {
  background: #000000;
  color: #ffffff;
}

.custom-grid__error-{{ grid_id }} {
  margin-top: 8px;
  font-size: 12px;
  color: #b42318;
  display: none;
}

.custom-grid__error-{{ grid_id }}.is-visible {
  display: block;
}

.custom-grid__add-btn-{{ grid_id }} {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 18px;
  width: 100%;
  min-height: 46px;
  margin-top: 18px;
  border: 0;
  background: {{ section.settings.add_to_cart_bg }};
  color: {{ section.settings.add_to_cart_text }};
  cursor: pointer;
  text-transform: uppercase;
  font-size: 14px;
  line-height: 1;
  overflow: hidden;
  letter-spacing: 0.02em;
}

.custom-grid__add-btn-{{ grid_id }}::before {
  content: "";
  position: absolute;
  inset: 0;
  width: 102%;
  transform: translateX(-101%);
  background: {{ section.settings.add_to_cart_hover_bg }};
  transition: transform 0.4s ease;
  z-index: 0;
}

.custom-grid__add-btn-{{ grid_id }} span {
  position: relative;
  z-index: 1;
}

.custom-grid__add-btn-{{ grid_id }}:hover::before {
  transform: translateX(0);
}

.custom-grid__add-btn-{{ grid_id }}:hover {
  color: {{ section.settings.add_to_cart_hover_text }};
}

.custom-grid__add-btn-{{ grid_id }}[disabled] {
  opacity: 0.6;
  cursor: not-allowed;
}

.custom-grid__add-arrow-{{ grid_id }} {
  transition: transform 0.3s ease;
}

.custom-grid__add-btn-{{ grid_id }}:hover .custom-grid__add-arrow-{{ grid_id }} {
  transform: translateX(5px);
}

@media screen and (max-width: 989px) {
  .custom-grid__list-{{ grid_id }} {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media screen and (max-width: 600px) {
  .custom-grid-section-{{ grid_id }} {
    padding: {{ section.settings.mobile_padding_top }}px 12px {{ section.settings.mobile_padding_bottom }}px;
  }

  .custom-grid__inner-{{ grid_id }} {
    max-width: 100%;
  }

  .custom-grid__heading-{{ grid_id }} {
    margin-bottom: 16px;
    font-size: {{ section.settings.mobile_heading_size }}px;
    padding: 0 6px;
  }

  .custom-grid__list-{{ grid_id }} {
    gap: 10px;
  }

  .custom-grid__hotspot-{{ grid_id }} {
    width: 22px;
    height: 22px;
    font-size: 16px;
  }

  .custom-grid__dialog-{{ grid_id }} {
    width: calc(100% - 8px);
    margin: 4px auto;
    padding: 10px 10px 14px;
    max-height: calc(100vh - 8px);
    overflow: auto;
  }

  .custom-grid__modal-content-{{ grid_id }} {
    grid-template-columns: 88px 1fr;
    gap: 10px;
  }

  .custom-grid__modal-image-{{ grid_id }} {
    width: 88px;
    aspect-ratio: 0.82;
  }
}
{% endstyle %}

<section class="custom-grid-section-{{ grid_id }}" {{ section.shopify_attributes }}>
  <div class="custom-grid__inner-{{ grid_id }}">
    {% if section.settings.heading != blank %}
      <h2 class="custom-grid__heading-{{ grid_id }}">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="custom-grid__list-{{ grid_id }}">
      {% for block in section.blocks limit: 6 %}
        {% assign product = block.settings.product %}
        <button
          type="button"
          class="custom-grid__card-{{ grid_id }}"
          data-grid-card
          data-product-json-id="grid-product-json-{{ grid_id }}-{{ block.id }}"
          {{ block.shopify_attributes }}
        >
          <div class="custom-grid__media-wrap-{{ grid_id }}">
            {% if product != blank %}
              {% if block.settings.custom_image != blank %}
                <img
                  src="{{ block.settings.custom_image | image_url: width: 900 }}"
                  alt="{{ product.title | escape }}"
                  loading="lazy"
                  width="600"
                  height="760"
                >
              {% elsif product.featured_image != blank %}
                <img
                  src="{{ product.featured_image | image_url: width: 900 }}"
                  alt="{{ product.title | escape }}"
                  loading="lazy"
                  width="600"
                  height="760"
                >
              {% else %}
                {{ 'product-apparel-1' | placeholder_svg_tag }}
              {% endif %}
            {% else %}
              {{ 'product-apparel-1' | placeholder_svg_tag }}
            {% endif %}

            <span
              class="custom-grid__hotspot-{{ grid_id }}"
              style="top: {{ block.settings.hotspot_top }}%; left: {{ block.settings.hotspot_left }}%;"
            >+</span>
          </div>
        </button>

        {% if product != blank %}
          <script type="application/json" id="grid-product-json-{{ grid_id }}-{{ block.id }}">
            {
              "id": {{ product.id | json }},
              "title": {{ product.title | json }},
              "handle": {{ product.handle | json }},
              "description": {{ product.description | strip_html | strip_newlines | json }},
              "featured_image": {{ product.featured_image | image_url: width: 900 | json }},
              "price": {{ product.price | json }},
              "available": {{ product.available | json }},
              "options": {{ product.options_with_values | json }},
              "variants": [
                {% for variant in product.variants %}
                  {
                    "id": {{ variant.id | json }},
                    "title": {{ variant.title | json }},
                    "available": {{ variant.available | json }},
                    "price": {{ variant.price | json }},
                    "compare_at_price": {{ variant.compare_at_price | json }},
                    "option1": {{ variant.option1 | json }},
                    "option2": {{ variant.option2 | json }},
                    "option3": {{ variant.option3 | json }},
                    "featured_image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 900 | json }}{% else %}null{% endif %}
                  }{% unless forloop.last %},{% endunless %}
                {% endfor %}
              ]
            }
          </script>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <div class="custom-grid__modal-{{ grid_id }}" data-grid-modal hidden>
    <div class="custom-grid__overlay-{{ grid_id }}" data-grid-overlay></div>
    <div
      class="custom-grid__dialog-{{ grid_id }}"
      role="dialog"
      aria-modal="true"
      aria-labelledby="custom-grid-modal-title-{{ grid_id }}"
    >
      <button
        type="button"
        class="custom-grid__close-{{ grid_id }}"
        aria-label="Close"
        data-grid-close
      >
        ×
      </button>

      <div class="custom-grid__modal-content-{{ grid_id }}">
        <div class="custom-grid__modal-image-{{ grid_id }}">
          <img src="" alt="" data-modal-image>
        </div>

        <div class="custom-grid__modal-details-{{ grid_id }}">
          <h3
            id="custom-grid-modal-title-{{ grid_id }}"
            class="custom-grid__product-title-{{ grid_id }}"
            data-modal-title
          ></h3>

          <p class="custom-grid__price-{{ grid_id }}" data-modal-price></p>

           <div class="custom-grid__description-{{ grid_id }}" data-modal-description></div>
        </div>
      </div>
      <div class="custom-grid__description-{{ grid_id }}" data-modal-description></div>

          <div class="custom-grid__options-wrap-{{ grid_id }}" data-modal-options></div>

          <p class="custom-grid__error-{{ grid_id }}" data-modal-error></p>

          <button
            type="button"
            class="custom-grid__add-btn-{{ grid_id }}"
            data-modal-add-to-cart
          >
            <span>{{ section.settings.add_to_cart_label }}</span>
            <span class="custom-grid__add-arrow-{{ grid_id }}">→</span>
          </button>
    </div>
  </div>

  {% assign bundle_product = all_products[section.settings.bundle_product_handle] %}
  {% if bundle_product != blank %}
    <script type="application/json" id="grid-bundle-product-json-{{ grid_id }}">
      {
        "id": {{ bundle_product.id | json }},
        "title": {{ bundle_product.title | json }},
        "handle": {{ bundle_product.handle | json }},
        "variants": [
          {% for variant in bundle_product.variants %}
            {
              "id": {{ variant.id | json }},
              "available": {{ variant.available | json }}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      }
    </script>
  {% endif %}
</section>

<script>
  (function() {
    const sectionRoot = document.querySelector('.custom-grid-section-{{ grid_id }}');
    if (!sectionRoot) return;

    const cards = sectionRoot.querySelectorAll('[data-grid-card]');
    const modal = sectionRoot.querySelector('[data-grid-modal]');
    const overlay = sectionRoot.querySelector('[data-grid-overlay]');
    const closeBtn = sectionRoot.querySelector('[data-grid-close]');
    const modalImage = sectionRoot.querySelector('[data-modal-image]');
    const modalTitle = sectionRoot.querySelector('[data-modal-title]');
    const modalPrice = sectionRoot.querySelector('[data-modal-price]');
    const modalDescription = sectionRoot.querySelector('[data-modal-description]');
    const modalOptions = sectionRoot.querySelector('[data-modal-options]');
    const addToCartBtn = sectionRoot.querySelector('[data-modal-add-to-cart]');
    const modalError = sectionRoot.querySelector('[data-modal-error]');

    const moneyFormat = {{ shop.money_format | json }};
    let currentProduct = null;
    let selectedOptions = [];
    let selectedVariant = null;
    let isAdding = false;

    function formatMoney(cents) {
      if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
        return window.Shopify.formatMoney(cents, moneyFormat);
      }
      return (cents / 100).toFixed(2);
    }

    function safeParseProduct(elId) {
      const node = document.getElementById(elId);
      if (!node) return null;
      try {
        return JSON.parse(node.textContent);
      } catch (e) {
        return null;
      }
    }

    function showError(message) {
      if (!modalError) return;
      modalError.textContent = message || '';
      modalError.classList.toggle('is-visible', Boolean(message));
    }

    function getFirstAvailableVariant(product) {
      if (!product || !product.variants) return null;
      return product.variants.find((v) => v.available) || product.variants[0] || null;
    }

    function buildInitialSelectedOptions(product) {
      const initialVariant = getFirstAvailableVariant(product);
      if (!initialVariant) return [];

      return product.options.map((option, index) => {
        const key = `option${index + 1}`;
        return initialVariant[key] || option.values[0] || '';
      });
    }

    function findMatchingVariant(product, optionValues) {
      if (!product || !product.variants) return null;

      return product.variants.find((variant) => {
        return optionValues.every((value, index) => {
          const key = `option${index + 1}`;
          return (variant[key] || '') === value;
        });
      }) || null;
    }

    function updateSelectedVariant() {
      selectedVariant = findMatchingVariant(currentProduct, selectedOptions) || getFirstAvailableVariant(currentProduct);
      if (!selectedVariant) return;

      modalPrice.textContent = formatMoney(selectedVariant.price);
      const img = selectedVariant.featured_image || currentProduct.featured_image || '';
      modalImage.src = img;
      modalImage.alt = currentProduct.title || '';

      if (!selectedVariant.available) {
        addToCartBtn.disabled = true;
        showError('This variant is currently unavailable.');
      } else {
        addToCartBtn.disabled = false;
        showError('');
      }
    }

    function renderColorOption(option, optionIndex) {
      const group = document.createElement('div');
      group.className = 'custom-grid__option-group-{{ grid_id }}';

      const label = document.createElement('label');
      label.className = 'custom-grid__option-label-{{ grid_id }}';
      label.textContent = option.name;
      group.appendChild(label);

      const list = document.createElement('div');
      list.className = 'custom-grid__pill-list-{{ grid_id }}';

      option.values.forEach((value) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'custom-grid__pill-{{ grid_id }}';
        btn.textContent = value;

        if (selectedOptions[optionIndex] === value) {
          btn.classList.add('is-active');
        }

        btn.addEventListener('click', () => {
          selectedOptions[optionIndex] = value;
          renderOptions();
          updateSelectedVariant();
        });

        list.appendChild(btn);
      });

      group.appendChild(list);
      return group;
    }

    function renderSizeDropdown(option, optionIndex) {
      const group = document.createElement('div');
      group.className = 'custom-grid__option-group-{{ grid_id }}';

      const label = document.createElement('label');
      label.className = 'custom-grid__option-label-{{ grid_id }}';
      label.textContent = option.name;
      group.appendChild(label);

      const dropdown = document.createElement('div');
      dropdown.className = 'custom-grid__dropdown-{{ grid_id }}';

      const trigger = document.createElement('button');
      trigger.type = 'button';
      trigger.className = 'custom-grid__dropdown-trigger-{{ grid_id }}';

      const labelText = document.createElement('span');
      labelText.className = 'custom-grid__dropdown-label-{{ grid_id }}';
      labelText.textContent = selectedOptions[optionIndex] || 'Choose your size';

      const arrow = document.createElement('span');
      arrow.className = 'custom-grid__dropdown-arrow-{{ grid_id }}';
      arrow.textContent = '⌃';

      trigger.appendChild(labelText);
      trigger.appendChild(arrow);

      const menu = document.createElement('div');
      menu.className = 'custom-grid__dropdown-menu-{{ grid_id }}';
      menu.hidden = true;

      trigger.addEventListener('click', () => {
        const isOpen = dropdown.classList.contains('is-open');

        sectionRoot.querySelectorAll('.custom-grid__dropdown-{{ grid_id }}').forEach((dd) => {
          dd.classList.remove('is-open');
          const ddMenu = dd.querySelector('.custom-grid__dropdown-menu-{{ grid_id }}');
          if (ddMenu) ddMenu.hidden = true;
        });

        if (!isOpen) {
          dropdown.classList.add('is-open');
          menu.hidden = false;
        }
      });

      option.values.forEach((value) => {
        const item = document.createElement('button');
        item.type = 'button';
        item.className = 'custom-grid__dropdown-item-{{ grid_id }}';
        item.textContent = value;

        if (selectedOptions[optionIndex] === value) {
          item.classList.add('is-selected');
        }

        item.addEventListener('click', () => {
          selectedOptions[optionIndex] = value;
          labelText.textContent = value;

          menu.querySelectorAll('.custom-grid__dropdown-item-{{ grid_id }}').forEach((el) => {
            el.classList.remove('is-selected');
          });

          item.classList.add('is-selected');
          dropdown.classList.remove('is-open');
          menu.hidden = true;
          updateSelectedVariant();
        });

        menu.appendChild(item);
      });

      dropdown.appendChild(trigger);
      dropdown.appendChild(menu);
      group.appendChild(dropdown);

      return group;
    }

    function renderOptions() {
      modalOptions.innerHTML = '';
      if (!currentProduct || !currentProduct.options) return;

      currentProduct.options.forEach((option, optionIndex) => {
        const optionName = (option.name || '').toLowerCase();
        const isColorLike = optionName.includes('color') || optionName.includes('colour');

        if (isColorLike) {
          modalOptions.appendChild(renderColorOption(option, optionIndex));
        }
      });

      currentProduct.options.forEach((option, optionIndex) => {
        const optionName = (option.name || '').toLowerCase();
        const isColorLike = optionName.includes('color') || optionName.includes('colour');

        if (!isColorLike) {
          modalOptions.appendChild(renderSizeDropdown(option, optionIndex));
        }
      });
    }

    function openModal(product) {
      currentProduct = product;
      selectedOptions = buildInitialSelectedOptions(product);
      selectedVariant = getFirstAvailableVariant(product);

      modalTitle.textContent = product.title || '';
      modalDescription.textContent = product.description || '';
      modalImage.src = (selectedVariant && selectedVariant.featured_image) || product.featured_image || '';
      modalImage.alt = product.title || '';

      renderOptions();
      updateSelectedVariant();

      modal.hidden = false;
      document.documentElement.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.hidden = true;
      document.documentElement.style.overflow = '';
      currentProduct = null;
      selectedOptions = [];
      selectedVariant = null;
      showError('');
    }

    cards.forEach((card) => {
      const hotspot = card.querySelector('.custom-grid__hotspot-{{ grid_id }}');
      if (!hotspot) return;

      hotspot.style.pointerEvents = 'auto';

      hotspot.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const id = card.getAttribute('data-product-json-id');
        const product = safeParseProduct(id);
        if (!product) return;

        openModal(product);
      });
    });

    overlay.addEventListener('click', closeModal);
    closeBtn.addEventListener('click', closeModal);

    document.addEventListener('click', (e) => {
      if (!e.target.closest('.custom-grid__dropdown-{{ grid_id }}')) {
        sectionRoot.querySelectorAll('.custom-grid__dropdown-{{ grid_id }}').forEach((dd) => {
          dd.classList.remove('is-open');
          const ddMenu = dd.querySelector('.custom-grid__dropdown-menu-{{ grid_id }}');
          if (ddMenu) ddMenu.hidden = true;
        });
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modal.hidden) {
        closeModal();
      }
    });

    function shouldAddBundle(optionValues) {
      if (!Array.isArray(optionValues)) return false;
      const normalized = optionValues.map((v) => String(v || '').trim().toLowerCase());
      return normalized.includes('black') && normalized.includes('medium');
    }

    function getBundleVariantId() {
      const bundleNode = document.getElementById('grid-bundle-product-json-{{ grid_id }}');
      if (!bundleNode) return null;

      try {
        const bundleProduct = JSON.parse(bundleNode.textContent);
        if (!bundleProduct || !bundleProduct.variants || !bundleProduct.variants.length) return null;

        const availableVariant = bundleProduct.variants.find((v) => v.available);
        return (availableVariant || bundleProduct.variants[0] || {}).id || null;
      } catch (e) {
        return null;
      }
    }

    async function addItemsToCart(items) {
      const response = await fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ items })
      });

      if (!response.ok) {
        let message = 'Unable to add item to cart.';
        try {
          const data = await response.json();
          if (data && data.description) {
            message = data.description;
          }
        } catch (e) {}
        throw new Error(message);
      }

      return response.json();
    }

    addToCartBtn.addEventListener('click', async () => {
      if (!selectedVariant || isAdding) return;

      if (!selectedVariant.available) {
        showError('This variant is currently unavailable.');
        return;
      }

      isAdding = true;
      addToCartBtn.disabled = true;
      showError('');

      try {
        const items = [{ id: selectedVariant.id, quantity: 1 }];

        if (shouldAddBundle(selectedOptions)) {
          const bundleVariantId = getBundleVariantId();
          if (bundleVariantId) {
            items.push({ id: bundleVariantId, quantity: 1 });
          }
        }

        await addItemsToCart(items);
        closeModal();
        document.dispatchEvent(new CustomEvent('cart:refresh'));
      } catch (error) {
        showError(error.message || 'Something went wrong.');
      } finally {
        isAdding = false;
        addToCartBtn.disabled = false;
      }
    });
  })();
</script>

