{% style %}
  .custom-banner-{{ section.id }} {
    display: block;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    overflow: hidden;
    background: transparent;
  }

  /* ================= TOP BAR ================= */

  .custom-banner__top-bar-{{ section.id }} {
    width: 100%;
    background: {{ section.settings.top_bar_bg_color }};
  }

  .custom-banner__brand-text-{{ section.id }},
  .custom-banner__mobile-brand-{{ section.id }},
  .custom-banner__mobile-panel-brand-{{ section.id }} {
    font-size: 16px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #111111;
  }

  .custom-banner__desktop-bar-{{ section.id }} {
    display: grid;
    grid-template-columns: minmax(160px, 1fr) auto minmax(180px, 1fr);
    align-items: center;
    gap: 20px;
    min-height: 64px;
    padding: {{ section.settings.top_bar_padding }}px {{ section.settings.horizontal_padding }}px;
    background-color: {{ section.settings.top_bar_bg_color }};
  }

  .custom-banner__desktop-logo-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    min-width: 160px;
    overflow: visible;
  }

  .custom-banner__desktop-logo-{{ section.id }} img {
    display: block;
    width: auto;
    max-width: {{ section.settings.logo_width }}px;
    height: auto;
    object-fit: contain;
  }

  .custom-banner__desktop-message-{{ section.id }} {
    text-align: center;
    color: {{ section.settings.top_message_color }};
    font-size: {{ section.settings.top_message_size }}px;
    line-height: 1.4;
    word-break: break-word;
  }

  .custom-banner__desktop-cta-{{ section.id }} {
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  /* ================= BUTTONS ================= */

  .custom-banner__top-button-{{ section.id }},
  .custom-banner__hero-button-{{ section.id }} {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 48px;
    padding: 12px 22px;
    min-width: 220px;
    max-width: 100%;
    text-decoration: none;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    border: none;
    outline: none;
    box-shadow: none;
    isolation: isolate;
    cursor: pointer;
    backface-visibility: hidden;
    -webkit-appearance: none;
    appearance: none;
    transform: translateZ(0);
  }

  .custom-banner__top-button-{{ section.id }} {
    background: {{ section.settings.top_button_bg }};
    color: {{ section.settings.top_button_text_color }};
    font-size: {{ section.settings.top_button_font_size }}px;
    border-radius: {{ section.settings.top_button_radius }}px;
    transition: color 0.3s ease, transform 0.25s ease, background-color 0.3s ease;
  }

  .custom-banner__hero-button-{{ section.id }} {
    background: {{ section.settings.hero_button_bg }};
    color: {{ section.settings.hero_button_text_color }};
    font-size: {{ section.settings.hero_button_font_size }}px;
    border-radius: {{ section.settings.hero_button_radius }}px;
    transition: color 0.3s ease, transform 0.25s ease, background-color 0.3s ease;
  }

  .custom-banner__top-button-{{ section.id }}::before,
  .custom-banner__hero-button-{{ section.id }}::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 102%;
    height: 100%;
    transform: translateX(-101%);
    transition: transform 0.4s ease;
    z-index: 0;
    pointer-events: none;
    will-change: transform;
  }

  .custom-banner__top-button-{{ section.id }}::before {
    background-color: {{ section.settings.top_button_hover_bg }};
  }

  .custom-banner__hero-button-{{ section.id }}::before {
    background-color: {{ section.settings.hero_button_hover_bg }};
  }

  .custom-banner__top-button-{{ section.id }} span,
  .custom-banner__hero-button-{{ section.id }} span,
  .custom-banner__arrow-{{ section.id }},
  .custom-banner__hero-arrow-{{ section.id }} {
    position: relative;
    z-index: 1;
    color: inherit;
  }

  .custom-banner__top-button-{{ section.id }}:hover::before,
  .custom-banner__hero-button-{{ section.id }}:hover::before {
    transform: translateX(0);
  }

  .custom-banner__top-button-{{ section.id }}:hover,
  .custom-banner__hero-button-{{ section.id }}:hover {
    transform: translateY(-2px);
    color: #111111;
    background: transparent;
  }

  .custom-banner__top-button-{{ section.id }}:focus,
  .custom-banner__top-button-{{ section.id }}:active,
  .custom-banner__hero-button-{{ section.id }}:focus,
  .custom-banner__hero-button-{{ section.id }}:active {
    outline: none;
    border: none;
    box-shadow: none;
  }

  .custom-banner__arrow-{{ section.id }},
  .custom-banner__hero-arrow-{{ section.id }} {
    transition: transform 0.3s ease;
    flex-shrink: 0;
  }

  .custom-banner__top-button-{{ section.id }}:hover .custom-banner__arrow-{{ section.id }},
  .custom-banner__hero-button-{{ section.id }}:hover .custom-banner__hero-arrow-{{ section.id }} {
    transform: translateX(5px);
  }

  /* ================= MOBILE ================= */

  .custom-banner__mobile-wrap-{{ section.id }} {
    display: none;
  }

  .custom-banner__mobile-trigger-{{ section.id }} {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    min-height: 52px;
    padding: 14px 16px;
    border: 0;
    background: {{ section.settings.top_bar_bg_color }};
    cursor: pointer;
  }

  .custom-banner__mobile-logo-image-{{ section.id }} {
    display: block;
    max-width: 140px;
    width: auto;
    height: auto;
    object-fit: contain;
    margin: 0 auto;
  }

  .custom-banner__menu-icon-{{ section.id }},
  .custom-banner__close-button-{{ section.id }},
  .custom-banner__close-icon-{{ section.id }} {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 20px;
    line-height: 1;
    color: #111111;
  }

  .custom-banner__close-button-{{ section.id }},
  .custom-banner__close-icon-{{ section.id }} {
    border: 0;
    background: transparent;
    cursor: pointer;
    padding: 0;
  }

  .custom-banner__mobile-panel-{{ section.id }} {
    padding: 0 0 16px;
    background: #F2F2F2;
  }

  .custom-banner__mobile-panel-header-{{ section.id }} {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 14px 16px;
    border-top: 1px solid #d9d9d9;
    box-shadow: 0 1px 0 #d9d9d9 inset;
  }

  .custom-banner__mobile-message-{{ section.id }} {
    margin-top: 14px;
    padding: 0 16px;
    text-align: center;
    color: {{ section.settings.top_message_color }};
    font-size: {{ section.settings.top_message_size }}px;
    line-height: 1.5;
    word-break: break-word;
  }

  .custom-banner__mobile-cta-{{ section.id }} {
    display: flex;
    justify-content: center;
    margin-top: 16px;
    padding: 0 16px;
  }

  .custom-banner__mobile-icon-wrap-{{ section.id }} {
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    position: relative;
  }

  .custom-banner__menu-icon-{{ section.id }}[hidden],
  .custom-banner__close-icon-{{ section.id }}[hidden] {
    display: none !important;
  }

  .custom-banner__mobile-spacer-{{ section.id }} {
    display: block;
    width: 48px;
    height: 48px;
  }

  .custom-banner__mobile-top-button-{{ section.id }} {
    width: 100%;
    max-width: 320px;
  }

  /* ================= HERO ================= */

  .custom-banner__hero-{{ section.id }} {
    position: relative;
    width: 100%;
    padding-left: 40px;
    padding-right: 40px;
  }

  .custom-banner__hero-top-{{ section.id }} {
    width: 100%;
    height: {{ section.settings.hero_top_height }}px;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .custom-banner__hero-top-{{ section.id }} svg,
  .custom-banner__hero-right-{{ section.id }} svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .custom-banner__hero-bottom-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr minmax(0, 890px);
    align-items: stretch;
    gap: 0;
  }

  .custom-banner__hero-left-{{ section.id }} {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background-color: {{ section.settings.hero_left_bg }};
    min-width: 0;
    padding-top: 10px;
    padding-bottom: 8px;
  }

  .custom-banner__hero-heading-{{ section.id }} {
    font-size: {{ section.settings.hero_heading_size }}px;
    color: {{ section.settings.hero_heading_color }};
    margin: 0 0 20px 0;
    line-height: 1.15;
    word-break: break-word;
  }

  .custom-banner__hero-description-{{ section.id }} {
    font-size: {{ section.settings.hero_description_size }}px;
    color: {{ section.settings.hero_description_color }};
    margin: 0 0 36px 0;
    line-height: 1.5;
    max-width: 483px;
    width: 100%;
    word-break: break-word;
  }

  .custom-banner__hero-right-{{ section.id }} {
    width: 100%;
    height: 100%;
    background-size: cover;
    background-repeat: no-repeat;
    background-color: transparent;
  }

  .custom-banner__bottom-strip-{{ section.id }} {
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: {{ section.settings.bottom_strip_bg }};
    text-align: center;
  }

  .custom-banner__bottom-text-{{ section.id }} {
    font-size: {{ section.settings.bottom_strip_font_size }}px;
    color: {{ section.settings.bottom_strip_color }};
    text-transform: uppercase;
    letter-spacing: 1px;
    line-height: 1.4;
    margin: 0;
    word-break: break-word;
  }

  /* ================= RESPONSIVE ================= */

  @media screen and (max-width: 1199px) {
    .custom-banner__hero-bottom-{{ section.id }} {
      grid-template-columns: 1fr minmax(0, 563px);
    }

    .custom-banner__hero-heading-{{ section.id }} {
      font-size: calc({{ section.settings.hero_heading_size }}px * 0.82);
    }

    .custom-banner__hero-description-{{ section.id }} {
      font-size: calc({{ section.settings.hero_description_size }}px * 0.95);
    }

    .custom-banner__top-button-{{ section.id }},
    .custom-banner__hero-button-{{ section.id }} {
      min-width: 190px;
      padding: 12px 20px;
    }
  }

  @media screen and (max-width: 1024px) {
    /* Desktop hide */
    .custom-banner__desktop-bar-{{ section.id }} {
      display: none;
    }

    /* Mobile wrapper */
    .custom-banner__mobile-wrap-{{ section.id }} {
      display: block;
      width: 100%;
      background: {{ section.settings.top_bar_bg_color }};
    }

    /* Mobile trigger button */
    .custom-banner__mobile-trigger-{{ section.id }} {
      width: 100%;
      display: grid;
      grid-template-columns: 48px 1fr 48px;
      align-items: center;
      min-height: 64px;
      padding: 9px 16px;
      border: none;
      background: {{ section.settings.top_bar_bg_color }};
      cursor: pointer;
    }

    /* Left icon wrap */
    .custom-banner__mobile-icon-wrap-{{ section.id }} {
      width: 20px;
      height: 20px;
      display: flex;
      align-items: center;
      justify-content: flex-start;
      position: relative;
    }

    /* Icons */
    .custom-banner__menu-icon-{{ section.id }},
    .custom-banner__close-icon-{{ section.id }} {
      position: static;
      transform: none;
      font-size: 18px;
      line-height: 1;
      color: #111111;
    }

    /* Center logo */
    .custom-banner__mobile-brand-{{ section.id }} {
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      font-size: 20px;
      font-weight: 700;
      line-height: 1;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: #111111;
      min-width: 0;
    }

    /* Message */
    .custom-banner__mobile-message-{{ section.id }} {
      text-align: center;
      color: {{ section.settings.top_message_color }};
      font-size: {{ section.settings.top_message_size }}px;
      line-height: 1.5;
      word-break: break-word;
    }

    /* Button wrap */
    .custom-banner__mobile-cta-{{ section.id }} {
      display: flex;
      justify-content: center;
      margin-top: 16px;
    }
  }

  @media screen and (min-width: 1025px) {
    .custom-banner__desktop-bar-{{ section.id }} {
      display: grid;
    }

    .custom-banner__mobile-wrap-{{ section.id }} {
      display: none;
    }
  }

  @media screen and (max-width: 989px) {
    .custom-banner__hero-bottom-{{ section.id }} {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .custom-banner__hero-right-{{ section.id }} {
      order: 1;
      min-height: 420px;
      background-size: contain;
      background-position: center;
    }

    .custom-banner__hero-left-{{ section.id }} {
      order: 2;
      align-items: center;
      text-align: center;
      padding: 36px 28px;
    }

    .custom-banner__hero-description-{{ section.id }} {
      max-width: 680px;
    }

    .custom-banner__hero-button-{{ section.id }} {
      align-self: center;
    }
  }

  @media screen and (max-width: 767px) {
    .custom-banner-{{ section.id }} {
      max-width: 100%;
    }

    .custom-banner__hero-top-{{ section.id }} {
      height: calc({{ section.settings.hero_top_height }}px * 0.72);
      min-height: 180px;
    }

    .custom-banner__hero-left-{{ section.id }} {
      padding: 28px 18px;
    }

    .custom-banner__hero-right-{{ section.id }} {
      min-height: 280px;
      background-size: cover;
      background-position: center;
    }

    .custom-banner__hero-heading-{{ section.id }} {
      font-size: calc({{ section.settings.hero_heading_size }}px * 0.58);
      margin-bottom: 16px;
    }

    .custom-banner__hero-description-{{ section.id }} {
      font-size: calc({{ section.settings.hero_description_size }}px * 0.95);
      margin-bottom: 24px;
      max-width: 100%;
    }

    .custom-banner__top-button-{{ section.id }},
    .custom-banner__hero-button-{{ section.id }} {
      min-width: 100%;
      width: 100%;
      max-width: 280px;
      min-height: 48px;
      padding: 12px 18px;
    }

    .custom-banner__bottom-strip-{{ section.id }} {
      padding-left: 16px;
      padding-right: 16px;
    }

    .custom-banner__bottom-text-{{ section.id }} {
      font-size: calc({{ section.settings.bottom_strip_font_size }}px * 0.92);
      letter-spacing: 0.4px;
    }
  }

  @media screen and (max-width: 600px) {
    .custom-banner__hero-left-{{ section.id }} {
      position: relative;
      padding-top: 49px !important;
      padding-bottom: 2px !important;
      order: 1;
    }

    .custom-banner__hero-button-{{ section.id }} {
      position: absolute;
      left: 50%;
      bottom: 20px;
      transform: translateX(-50%) translateY(0);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: calc(100% - 32px);
      max-width: 260px;
      height: 50px;
      gap: 10px;
      text-decoration: none;
      font-size: {{ section.settings.hero_button_font_size }}px;
      color: #ffffff;
      background-color: #000000;
      border: none;
      outline: none;
      overflow: hidden;
      transition: color 0.3s ease, transform 0.3s ease;
      z-index: 5;
    }

    .custom-banner__hero-button-{{ section.id }}::before {
      background-color: #FFF544;
    }

    .custom-banner__hero-button-{{ section.id }}:hover {
      transform: translateX(-50%) translateY(-2px);
      color: #000000;
      background: transparent;
    }

    .custom-banner__mobile-brand-{{ section.id }},
    .custom-banner__mobile-panel-brand-{{ section.id }} {
      font-size: 15px;
    }

    .custom-banner__mobile-message-{{ section.id }} {
      font-size: calc({{ section.settings.top_message_size }}px * 0.95);
    }

    .custom-banner__top-button-{{ section.id }},
    .custom-banner__hero-button-{{ section.id }} {
      min-width: 0;
      font-size: 14px;
    }

    .custom-banner__hero-top-{{ section.id }} {
      display: none;
    }

    .custom-banner__hero-{{ section.id }} {
      padding-left: 0px;
      padding-right: 0px;
    }

    .custom-banner__hero-right-{{ section.id }} {
      min-height: 220px;
    }

    .custom-banner__hero-heading-{{ section.id }} {
      font-size: 30px;
    }

    .custom-banner__hero-description-{{ section.id }} {
      font-size: 16px;
    }

    .custom-banner__bottom-strip-{{ section.id }} {
      padding-left: 4px;
      padding-right: 4px;
    }

    .custom-banner__bottom-text-{{ section.id }} {
      font-size: 14px;
    }
  }
{% endstyle %}

<custom-banner-{{ section.id }} class="custom-banner-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="custom-banner__top-bar-{{ section.id }}">
    <!-- Desktop Bar -->
    <div class="custom-banner__desktop-bar-{{ section.id }}">
      <div class="custom-banner__desktop-logo-{{ section.id }}">
        {% if section.settings.logo != blank %}
          <img
            src="{{ section.settings.logo | image_url: width: 400 }}"
            alt="{{ section.settings.logo.alt | escape }}"
            width="{{ section.settings.logo_width }}"
            height="auto"
            loading="lazy"
          >
        {% else %}
          <span class="custom-banner__brand-text-{{ section.id }}">
            {{ section.settings.logo_text }}
          </span>
        {% endif %}
      </div>

      <div class="custom-banner__desktop-message-{{ section.id }}">
        {{ section.settings.top_message }}
      </div>

      <div class="custom-banner__desktop-cta-{{ section.id }}">
        <a
          href="{{ section.settings.top_button_link | default: '#' }}"
          class="custom-banner__top-button-{{ section.id }}"
        >
          <span>{{ section.settings.top_button_label }}</span>
        </a>
      </div>
    </div>

    <!-- Mobile Bar -->
    <div class="custom-banner__mobile-wrap-{{ section.id }}">
      <button
        type="button"
        class="custom-banner__mobile-trigger-{{ section.id }}"
        aria-expanded="false"
        aria-controls="custom-banner-mobile-panel-{{ section.id }}"
      >
        <span class="custom-banner__mobile-icon-wrap-{{ section.id }}">
          <span class="custom-banner__menu-icon-{{ section.id }}">☰</span>
          <span class="custom-banner__close-icon-{{ section.id }}" hidden>✕</span>
        </span>

        <span class="custom-banner__mobile-brand-{{ section.id }}">
          {% if section.settings.logo != blank %}
            <img
              src="{{ section.settings.logo | image_url: width: 300 }}"
              alt="{{ section.settings.logo.alt | escape }}"
              width="{{ section.settings.logo_width }}"
              height="auto"
              loading="lazy"
              class="custom-banner__mobile-logo-image-{{ section.id }}"
            >
          {% else %}
            {{ section.settings.logo_text }}
          {% endif %}
        </span>

        <span class="custom-banner__mobile-spacer-{{ section.id }}"></span>
      </button>

      <div
        id="custom-banner-mobile-panel-{{ section.id }}"
        class="custom-banner__mobile-panel-{{ section.id }}"
        hidden
      >
        <div class="custom-banner__mobile-message-{{ section.id }}">
          {{ section.settings.top_message }}
        </div>

        <div class="custom-banner__mobile-cta-{{ section.id }}">
          <a
            href="{{ section.settings.top_button_link | default: '#' }}"
            class="custom-banner__top-button-{{ section.id }} custom-banner__mobile-top-button-{{ section.id }}"
          >
            <span>{{ section.settings.top_button_label }}</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Hero Section -->
  <div class="custom-banner__hero-{{ section.id }}">
    <div
      class="custom-banner__hero-top-{{ section.id }}"
      {% if section.settings.hero_top_image %}
        style="background-image: url('{{ section.settings.hero_top_image | image_url: width: 2000 }}');"
      {% endif %}
    >
      {% unless section.settings.hero_top_image %}
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      {% endunless %}
    </div>

    <div class="custom-banner__hero-bottom-{{ section.id }}">
      <div class="custom-banner__hero-left-{{ section.id }}">
        {% if section.settings.hero_heading != blank %}
          <h2 class="custom-banner__hero-heading-{{ section.id }}">
            {{ section.settings.hero_heading }}
          </h2>
        {% endif %}

        {% if section.settings.hero_description != blank %}
          <div class="custom-banner__hero-description-{{ section.id }}">
            {{ section.settings.hero_description }}
          </div>
        {% endif %}

        <a
          href="{{ section.settings.hero_button_link }}"
          class="custom-banner__hero-button-{{ section.id }}"
        >
          <span>{{ section.settings.hero_button_label }}</span>
        </a>
      </div>

      <div
        class="custom-banner__hero-right-{{ section.id }}"
        {% if section.settings.hero_bottom_right_image %}
          style="background-image: url('{{ section.settings.hero_bottom_right_image | image_url: width: 1500 }}');"
        {% endif %}
      >
        {% unless section.settings.hero_bottom_right_image %}
          {{ 'collection-apparel-1' | placeholder_svg_tag }}
        {% endunless %}
      </div>
    </div>
  </div>

  <!-- Bottom Strip -->
  <div class="custom-banner__bottom-strip-{{ section.id }}">
    <p class="custom-banner__bottom-text-{{ section.id }}">
      {{ section.settings.bottom_strip_text }}
    </p>
  </div>
</custom-banner-{{ section.id }}>

<script>
  (function() {
    class CustomBanner{{ section.id | liquid_replace: '-', '_' }} extends HTMLElement {
      connectedCallback() {
        this.initBanner();
      }

      initBanner() {
        this.handleEmptyLinks();
        this.handleMobileToggle();
      }

      handleEmptyLinks() {
        const buttons = this.querySelectorAll('a');
        buttons.forEach((button) => {
          button.addEventListener('click', (e) => {
            const href = button.getAttribute('href');
            if (!href || href.trim() === '') {
              e.preventDefault();
            }
          });
        });
      }

      handleMobileToggle() {
        const trigger = this.querySelector('.custom-banner__mobile-trigger-{{ section.id }}');
        const panel = this.querySelector('.custom-banner__mobile-panel-{{ section.id }}');
        const menuIcon = this.querySelector('.custom-banner__menu-icon-{{ section.id }}');
        const closeIcon = this.querySelector('.custom-banner__close-icon-{{ section.id }}');

        if (!trigger || !panel || !menuIcon || !closeIcon) return;

        trigger.addEventListener('click', () => {
          const isOpen = trigger.getAttribute('aria-expanded') === 'true';

          if (isOpen) {
            trigger.setAttribute('aria-expanded', 'false');
            panel.hidden = true;
            menuIcon.hidden = false;
            closeIcon.hidden = true;
          } else {
            trigger.setAttribute('aria-expanded', 'true');
            panel.hidden = false;
            menuIcon.hidden = true;
            closeIcon.hidden = false;
          }
        });
      }
    }

    if (!customElements.get('custom-banner-{{ section.id }}')) {
      customElements.define('custom-banner-{{ section.id }}', CustomBanner{{ section.id | liquid_replace: '-', '_' }});
    }
  })();
</script>

